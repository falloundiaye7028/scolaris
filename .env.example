DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=GENERER_UN_SECRET_ALEATOIRE_D_AU_MOINS_32_CARACTERES
CRON_SECRET=GENERER_UN_SECRET_DISTINCT
# Requis uniquement lors de la toute première initialisation, puis à supprimer.
BOOTSTRAP_SECRET=GENERER_UN_SECRET_TEMPORAIRE_DISTINCT
# Origines supplémentaires éventuelles, séparées par des virgules. L'origine courante est toujours acceptée.
ALLOWED_ORIGINS=https://www.scolarispay.online
# Activation progressive : off, privileged ou all. Conserver off jusqu'à validation de la récupération MFA.
MFA_ENFORCEMENT=off
MFA_ENCRYPTION_KEY=GENERER_32_OCTETS_ALEATOIRES_EN_BASE64_OU_64_CARACTERES_HEXADECIMAUX
MFA_ISSUER=SCOLARIS PAY
# Optionnels : le webhook HTTPS doit distribuer le jeton sans le journaliser.
PASSWORD_RESET_WEBHOOK_URL=https://FOURNISSEUR_EXEMPLE/integrations/password-reset
PASSWORD_RESET_WEBHOOK_SECRET=GENERER_UN_SECRET_DISTINCT
SCOLARIS_PREVIEW_DATABASE_FINGERPRINT=
# Optionnels : alertes agrégées vers un collecteur HTTPS approuvé.
SECURITY_ALERT_WEBHOOK_URL=https://COLLECTEUR_EXEMPLE/security-events
SECURITY_ALERT_WEBHOOK_SECRET=GENERER_UN_SECRET_DISTINCT
# Offre unique SCOLARIS PAY. Ces valeurs sont validées côté serveur.
SCOLARIS_MONTHLY_PRICE_XOF=50000
SCOLARIS_GRACE_PERIOD_DAYS=7
# Webhook HTTPS existant chargé d’envoyer la confirmation d’inscription.
SCHOOL_REGISTRATION_WEBHOOK_URL=https://FOURNISSEUR_EXEMPLE/integrations/school-registration
SCHOOL_REGISTRATION_WEBHOOK_SECRET=GENERER_UN_SECRET_DISTINCT
# Alternative directe Resend côté serveur. La clé doit avoir uniquement l’accès d’envoi.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SCOLARIS PAY <noreply@mail.scolarispay.online>
# Webhook HTTPS optionnel pour les changements d’état d’abonnement.
SCHOOL_NOTIFICATION_WEBHOOK_URL=https://FOURNISSEUR_EXEMPLE/integrations/school-notification
SCHOOL_NOTIFICATION_WEBHOOK_SECRET=GENERER_UN_SECRET_DISTINCT
# Base exclusivement dédiée aux tests d'intégration ; son nom doit contenir "test".
TEST_DATABASE_URL=postgresql://scolaris:scolaris_dev@127.0.0.1:55432/scolaris_test

# Relances : activation explicite après configuration et vérification des prestataires.
REMINDER_DELIVERY_ENABLED=false
# E-mail : RESEND_API_KEY et RESEND_FROM_EMAIL déjà utilisés par le service.
REMINDER_GATEWAY_URL=
REMINDER_GATEWAY_SECRET=
# La passerelle SMS/WhatsApp doit respecter Idempotency-Key et retourner {"id":"..."}.
# Callback de livraison : POST /api/integrations/reminders/delivery, Bearer secret,
# corps {"id":"UUID de relance","providerId":"ID prestataire","status":"delivered|failed"}.

# Wave : chaque école reçoit sur son propre compte marchand. Aucun secret côté navigateur.
WAVE_CHECKOUT_ENABLED=false
WAVE_SCHOOL_MERCHANTS={}
# Objet indexé par UUID école : apiKey, webhookSecret, signingSecret facultatif.
# Webhook signé : POST /api/integrations/wave/UUID-ECOLE.
