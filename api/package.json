{
  "name": "scolaris-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test",
    "lint": "node --check src/server.js && node --check src/security.js && node --check src/auth-security.js && node --check src/auth-service.js && node --check src/migrate.js",
    "typecheck": "npm run lint",
    "build": "npm run lint && npm test"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "bcryptjs": "3.0.3",
    "fflate": "0.7.5",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.0",
    "read-excel-file": "9.3.10"
  }
}
