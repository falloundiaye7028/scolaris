{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "api/src/schema.sql"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/", "destination": "/web/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/subscriptions", "schedule": "10 0 * * *" }
  ]
}
